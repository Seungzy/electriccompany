DirectoryIndex index.php
Options -Indexes

# Keep database credentials inaccessible from the web.
<Files ".env">
    Require all denied
</Files>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Send application routes to CodeIgniter, but serve real files directly.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L,QSA]
</IfModule>
